+/* SuperCalc patch: on soft reset stop the DMA/IRQ audio engine and forget the
+ * registered samples. Their buffers live in the GC heap, which is about to be
+ * re-initialised; the ISR would otherwise keep reading them and the sample table
+ * would keep its old entries (filling up after a few soft resets). */
+void picosampler_soft_reset(void) {
+    ps_deinit();
+    for (int i = 0; i < MAX_SAMPLES; i++) {
+        samples[i].data = NULL;
+        samples[i].len = 0;
+        MP_STATE_PORT(picosampler_keepalive)[i] = MP_OBJ_NULL;
+    }
+    n_samples = 0;
+}
