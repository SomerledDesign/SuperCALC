+ * 30 bits so it stays a small int). Diagnostics: no change over a few 100 ms while
+ * auto-refresh is on means core 1 is not refreshing the LCD. */
+static mp_obj_t pd_frames(void) {
+    return MP_OBJ_NEW_SMALL_INT((mp_int_t)(core1_frames & 0x3FFFFFFF));
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(pd_frames_obj, pd_frames);
