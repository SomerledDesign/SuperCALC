+/* SuperCalc 20261115g: pushNow() pushes the current frame synchronously from the
+ * calling core (core 0) and leaves auto-refresh running; core 1 is never reset.
+ * Holds core 1 off with skipUpdate, waits (bounded) for any frame core 1 is pushing
+ * to finish and for the DMA/SPI to go idle, pushes the frame, then clears skipUpdate
+ * (like update() does), so core 1 carries on refreshing. Returns True if this call
+ * pushed the frame; False if there is no framebuffer, or core 1 stayed busy for
+ * 250 ms (then nothing is pushed by this call, skipUpdate is still cleared and core 1
+ * pushes the frame itself). */
+static mp_obj_t pd_pushNow(void) {
+    if (frameBuff == NULL || pColorUpdate == NULL) {
+      return mp_const_false;
+    }
+    skipUpdate = true;
+    __dmb();
+    absolute_time_t until = make_timeout_time_ms(250);
+    while (core1_busy && !time_reached(until)) {
+      tight_loop_contents();
+    }
+    if (core1_busy) {
+      skipUpdate = false;
+      return mp_const_false;
+    }
+    pd_wait_dma();
+    while (spi_get_hw(SPI_DISP)->sr & SPI_SSPSR_BSY_BITS) {
+      tight_loop_contents();
+    }
+    pColorUpdate(frameBuff,DISPLAY_HEIGHT*DISPLAY_WIDTH, LUT);
+    skipUpdate = false;
+    return mp_const_true;
+}
+static MP_DEFINE_CONST_FUN_OBJ_0(pd_pushNow_obj, pd_pushNow);
