+/* Stop core 1 if we launched it: ask it to park, wait (bounded), then reset it. */
+static void pd_core1_stop(void) {
+  if (core1_running) {
+    core1_stop_req = true;
+    __sev();
+    absolute_time_t until = make_timeout_time_ms(500);
+    while (!core1_parked && !time_reached(until)) {
+      tight_loop_contents();
+    }
+    multicore_reset_core1();
+    core1_running = false;
+    core1_busy = false;  /* 20261115g: a reset mid-frame must not leave it set */
+    #if MICROPY_PY_THREAD
+    if (core1_entry == pd_core1_marker) {
+      core1_entry = NULL;
+    }
+    #endif
+  }
+  core1_stop_req = false;
+  core1_parked = false;
+  pd_wait_dma();
+}
+
+static void pd_core1_start(void) {
+  pd_core1_stop();
+  #if MICROPY_PY_THREAD
+  if (core1_entry != NULL) {
+    mp_raise_msg(&mp_type_OSError, MP_ERROR_TEXT("core1 in use"));
+  }
+  core1_entry = pd_core1_marker;
+  #endif
+  core1_running = true;
+  multicore_launch_core1_with_stack(core1_main, core1_stack, CORE1_STACK_SIZE);
