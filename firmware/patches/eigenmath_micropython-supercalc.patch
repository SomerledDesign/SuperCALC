 // automatic variables not visible to the garbage collector are reclaimed
 
+/* SuperCalc patch: reclaim the atoms a failed integral-table candidate allocated.
+ * A normal gc() is only safe between top-level evaluations because callers keep atoms
+ * in C locals. Here we only free atoms that were on the free list when the candidate
+ * started (so nothing a caller holds can be freed) and that are now unreachable from
+ * the roots. eigenmath never mutates an older atom to point at a newer one (bindings
+ * go through the root tables), so this is safe. Upstream needs ~1.5x more atoms for
+ * integral() without it. */
+static int em_reclaim_gc_count;
+static int em_reclaim_armed;
+
+void
+em_reclaim_begin(void)
+{
+	int i;
+	struct atom *p;
+	for (i = 0; i < MAXATOMS; i++)
+		mem[i].tag = 0;
+	for (p = free_list; p; p = p->u.next)
+		p->tag = 1;
+	em_reclaim_gc_count = gc_count;
+	em_reclaim_armed = 1;
+}
+
+void
+em_reclaim_end(void)
+{
+	int i;
+	struct atom *p;
+
+	if (!em_reclaim_armed || gc_count != em_reclaim_gc_count)
+		return;  /* a real gc ran meanwhile; tags are not ours */
+	em_reclaim_armed = 0;
+
+	untag(zero);
+	untag(one);
+	untag(minusone);
+	untag(imaginaryunit);
+	for (i = 0; i < tos; i++)
+		untag(stack[i]);
+	for (i = 0; i < 27 * BUCKETSIZE; i++) {
+		untag(symtab[i]);
+		untag(binding[i]);
+		untag(usrfunc[i]);
+	}
+
+	free_list = NULL;
+	free_count = 0;
+	for (i = MAXATOMS - 1; i >= 0; i--) {
+		p = &mem[i];
+		if (p->tag == 0)
+			continue;
+		switch (p->atomtype) {
+			case KSYM:
+				e_free(p->u.ksym.name);
+				ksym_count--;
+				break;
+			case USYM:
+				e_free(p->u.usym.name);
+				usym_count--;
+				break;
+			case RATIONAL:
+				mfree(p->u.q.a);
+				mfree(p->u.q.b);
+				break;
+			case STR:
+				if (p->u.str)
+					e_free(p->u.str);
+				string_count--;
+				break;
+			case TENSOR:
+				e_free(p->u.tensor);
+				tensor_count--;
+				break;
+			default:
+				break; // FREEATOM, CONS, or DOUBLE
+		}
+		p->atomtype = FREEATOM;
+		p->u.next = free_list;
+		free_list = p;
+		free_count++;
+	}
+}
