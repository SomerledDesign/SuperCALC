# GraphingCalc - PicoCalc Project

# Build artifacts
build/
*.uf2
*.o
*.elf
*.map
firmware/*.uf2
firmware/build/

# Python / MicroPython
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Thonny / IDE
.thonny/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Temporary / test
*.tmp
*.log
tests/output/
*.raw

# SD card images or large data (user can add their own)
*.img
*.bin

# Dashboard / local tools temp
tools/dashboard_temp/
*.diff

# C build (Pico SDK style)
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# User data that shouldn't be committed (examples can be committed)
examples/user_private/
programs/my_secrets/

# macOS
**/.DS_Store
supercalc.og.uf2*

# Ralph Loop / unattended automation transients (produced by tools/ralph.sh)
claude_report.txt
.ralph/
ralph_live.log
.last_ralph_pid
*.log

# Note: handoffs/ are intentionally tracked as the audit history of the loop.
# The ralph script filters them from dirty checks.

# SuperCALC release hygiene: never commit firmware binaries or backups
build/
*.uf2
*.uf2.*
*.bak
*.bak-*
*.orig
.DS_Store
